<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Swing report -- {{ source_name }}</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #ffffff; --fg: #1a1a1a; --muted: #6b6b6b; --card: #f5f5f5;
    --accent: #2b6cb0; --border: #dcdcdc;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #16171a; --fg: #eaeaea; --muted: #9a9a9a; --card: #202226; --border: #34363b; }
  }
  * { box-sizing: border-box; }
  body {
    background: var(--bg); color: var(--fg); margin: 0; padding: 1.25rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    line-height: 1.45; max-width: 760px; margin-inline: auto;
  }
  h1 { font-size: 1.4rem; margin-bottom: 0.1rem; }
  h2 { font-size: 1.1rem; margin-top: 2.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.4rem; }
  .meta { color: var(--muted); font-size: 0.85rem; margin-bottom: 1.5rem; }
  video { width: 100%; border-radius: 8px; background: #000; margin: 0.75rem 0; }
  img.plot { width: 100%; border-radius: 8px; }
  .stills { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 0.75rem 0; }
  .stills figure { margin: 0; flex: 1 1 30%; min-width: 140px; }
  .stills img { width: 100%; border-radius: 6px; display: block; }
  .stills figcaption { font-size: 0.75rem; color: var(--muted); text-align: center; margin-top: 0.25rem; }
  .card { background: var(--card); border-radius: 10px; padding: 0.9rem 1rem; margin: 0.75rem 0; }
  .card.biggest { border-left: 3px solid var(--accent); }
  .card h3 { margin: 0 0 0.4rem; font-size: 0.95rem; }
  .card .badge { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--accent); font-weight: 600; }
  .card p { margin: 0.3rem 0; }
  .card .cue { font-size: 0.95rem; }
  .card .drill { color: var(--muted); font-size: 0.85rem; margin-top: 0.5rem; }
  .card .detail { color: var(--muted); font-size: 0.78rem; margin-top: 0.4rem; }
  .card.unmeasurable { opacity: 0.6; }
  details { margin: 1rem 0; }
  summary { cursor: pointer; color: var(--muted); font-size: 0.85rem; }
  table { width: 100%; border-collapse: collapse; margin: 0.5rem 0; font-size: 0.85rem; }
  th, td { text-align: left; padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--border); }
  th { color: var(--muted); font-weight: 600; }
  .unmeasurable-row { color: var(--muted); font-style: italic; }
  .confidence-low { color: #c05621; }
  footer { color: var(--muted); font-size: 0.75rem; margin-top: 3rem; text-align: center; }
</style>
</head>
<body>

<h1>Swing report</h1>
<div class="meta">
  {{ source_name }} &middot; {{ n_frames }} frames @ {{ "%.1f"|format(fps) }}fps &middot;
  {{ swings|length }} swing(s) detected &middot; generated {{ generated_at }}
</div>

<h2>Session overview</h2>
<img class="plot" src="data:image/png;base64,{{ velocity_plot_b64 }}" alt="wrist speed with detected events">

{% for swing in swings %}
<h2>Swing {{ swing.index }} &middot; {{ "%.1f"|format(swing.start_s) }}s&ndash;{{ "%.1f"|format(swing.end_s) }}s</h2>

<video controls playsinline muted loop>
  <source src="data:video/mp4;base64,{{ swing.video_b64 }}" type="video/mp4">
</video>

<div class="stills">
  <figure><img src="data:image/png;base64,{{ swing.address_frame_b64 }}"><figcaption>address (frame {{ swing.address_idx }})</figcaption></figure>
  <figure><img src="data:image/png;base64,{{ swing.top_frame_b64 }}"><figcaption>top (frame {{ swing.top_idx }})</figcaption></figure>
  <figure><img src="data:image/png;base64,{{ swing.impact_frame_b64 }}"><figcaption>impact (frame {{ swing.impact_idx }})</figcaption></figure>
</div>

{% for line in swing.lines %}
<div class="card {{ 'biggest' if swing.biggest and line.name == swing.biggest.name else '' }} {{ 'unmeasurable' if line.value is none else '' }}">
  {% if swing.biggest and line.name == swing.biggest.name %}<div class="badge">Biggest change</div>{% endif %}
  {% if swing.steadiest and line.name == swing.steadiest.name %}<div class="badge">Steadiest</div>{% endif %}
  <h3>{{ line.pretty_name }}</h3>
  <p class="cue">{{ line.cue }}</p>
  {% if swing.biggest and line.name == swing.biggest.name %}
  <p class="drill">{{ swing.biggest_drill }}</p>
  {% endif %}
  {% if line.detail %}<p class="detail">{{ line.detail }} &middot; {{ "%.0f"|format(line.confidence * 100) }}% confidence</p>{% endif %}
</div>
{% endfor %}

<details>
  <summary>Raw measurements</summary>
  <table>
    <thead>
      <tr><th>Fault</th><th>Value</th><th>Peak frame</th><th>Confidence</th></tr>
    </thead>
    <tbody>
    {% for line in swing.lines %}
      <tr class="{{ 'unmeasurable-row' if line.value is none else '' }}">
        <td>{{ line.pretty_name }}</td>
        <td>
          {% if line.value is none %}not measurable
          {% else %}{{ "%+.2f"|format(line.value) }} {{ line.unit }}{% endif %}
        </td>
        <td>{{ line.peak_frame if line.peak_frame is not none else "--" }}</td>
        <td class="{{ 'confidence-low' if line.confidence < 0.5 else '' }}">{{ "%.0f"|format(line.confidence * 100) }}%</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</details>
{% endfor %}

<footer>swingcoach &middot; personal tool, not a product &middot; see PLAN.md</footer>
</body>
</html>
